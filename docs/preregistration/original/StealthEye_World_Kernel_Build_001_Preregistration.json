    "desktop_eye": false,
    "multi_agent_swarm": false,
    "primary_correspondence": "git:working_copy_of",
    "repository_same_as_available": false
  },
  "semantic_actions": [
    "git:create_local_commit",
    "git:create_branch",
    "git:push_ref",
    "github:create_remote_commit",
    "git:fetch_remote",
    "git:integrate_fast_forward"
  ],
  "primary_arms": [
    "cold",
    "conventional_memory",
    "structured"
  ],
  "primary_comparison": "structured_vs_conventional_memory",
  "primary_metric": "configuration_block_mean_brier_loss",
  "effect_target": {
    "relative_brier_loss_reduction": 0.20,
    "formula": "(mean_memory_brier - mean_structured_brier) / mean_memory_brier"
  },
  "statistical_analysis": {
    "paired_by": "configuration_block",
    "bootstrap_resamples": 10000,
    "confidence_level": 0.95,
    "randomization_test_alpha": 0.05,
    "cold_comparison_primary": false
  },
  "history_fairness": {
    "same_acquisition_episode_source_set": true,
    "same_candidate_episode_ids_for_memory_and_structured": true,
    "extra_llm_calls_for_structured": 0,
    "candidate_max_inherited_tokens": 6000,
    "candidate_max_inherited_utf8_bytes": 32768,
    "pilot_may_reduce_budget": true,
    "pilot_may_raise_budget_above_8000_tokens": false
  },
  "acquisition": {
    "fresh_invocation_each_configuration_block": true,
    "prior_inherited_memory": false,
    "initial_blocks": 24,
    "maximum_blocks": 36,
    "minimum_eligible_episodes_per_action_class": 20,
    "minimum_push_accepts": 8,
    "minimum_push_rejects": 8,
    "minimum_fast_forward_accepts": 8,
    "minimum_fast_forward_rejects": 8,
    "minimum_distinct_configuration_seeds_per_action": 6
  },
  "pilot": {
    "blocks": 12,
    "excluded_from_confirmatory_analysis": true,
    "memory_brier_headroom_minimum": 0.05,
    "may_tune": [
      "H1_H2_H3_horizons",
      "inherited_package_budget_within_spec_bounds",
      "serialization_format_without_information_change",
      "fixture_reset_mechanics",
      "unambiguous_outcome_proposition_schema",
      "confirmatory_sample_size_via_locked_formula",
      "provider_wait_and_censor_mechanics"
    ],
    "may_not_tune": [
      "primary_comparison",
      "20_percent_effect_target",
      "primary_brier_metric_family",
      "three_primary_arms",
      "six_semantic_action_classes",
      "kernel_ontology_boundary",
      "provider_authority",
      "original_eye_constraints",
      "fresh_invocation_requirement",
      "equal_information_and_compute_requirement"
    ]
  },
  "confirmatory_sample_size": {
    "status": "pilot_derived",
    "formula": "delta=0.20*mean_memory_pilot_brier; n_raw=((1.959964+0.841621)*sd_paired_difference/delta)^2; N=ceil_to_multiple_of_8(max(48,n_raw))",
    "minimum": 48,
    "maximum_feasible": 96,
    "if_calculated_above_maximum": "redesign_and_rerun_pilot_before_confirmatory",
    "if_pilot_memory_brier_below_headroom": "redesign_and_rerun_pilot_before_confirmatory"
  },
  "behavioral_metric": {
    "name": "excess_material_actions",
    "formula": "max(0, actual_material_actions - evaluator_oracle_minimum_material_actions)",
    "relative_reduction_target_when_memory_has_headroom": 0.20,
    "task_completion_max_allowed_drop_percentage_points": 5,
    "consequential_error_increase_allowed": false
  },
  "drift": {
    "minimum_fraction_of_confirmatory_blocks": 0.3333333333,
    "fresh_invocation_each_contradiction_opportunity": true,
    "max_strong_contradictions_before_obsolete_probability_must_be_at_most_0_5": 3,
    "strong_pass_fraction_meeting_bound": 0.90
  },
  "hard_invariants": [
    "prediction_durable_before_dispatch",
    "prediction_immutable",
    "changed_action_requires_new_attempt_and_prediction",
    "evidence_content_addressed_and_immutable",

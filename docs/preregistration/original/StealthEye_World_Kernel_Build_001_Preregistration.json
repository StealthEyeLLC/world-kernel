    "chrome_descriptor_observed": "151.0.7922.109",
    "portable_node_observed": "24.18.1",
    "postgres_observed": "not_installed_or_not_discoverable_at_spec_time",
    "liveness_rule": "live_probe_beats_persisted_descriptor"
  },
  "architecture": {
    "primary_store": "PostgreSQL 18.x, experiment-owned on-demand process, no permanent Windows service",
    "implementation_language_preference": ".NET 10 / C# unless a concrete implementation blocker is documented",
    "eyes": ["CODEeye", "eyeBROWSE"],
    "universal_entity": false,
    "universal_state": false,
    "universal_event": false,
    "persistent_rules": false,
    "persistent_capability_model": false,

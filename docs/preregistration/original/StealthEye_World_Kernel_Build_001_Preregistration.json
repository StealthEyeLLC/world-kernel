    "valid_as_of_and_known_as_of_independent",
    "replayed_old_evidence_not_fresh",
    "provider_outage_yields_unknown_not_assumed_unchanged",
    "projections_rebuildable_and_non_authoritative",
    "closed_episode_has_complete_lifecycle",
    "hidden_evaluator_labels_never_operator_visible",
    "memory_and_structured_use_same_source_episode_candidates",
    "same_model_and_base_instructions_across_arms",
    "fresh_context_each_arm_run",

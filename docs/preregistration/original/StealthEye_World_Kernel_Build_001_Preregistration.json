{
  "schema": "stealtheye-world-kernel-build001-prereg-v1",
  "date": "2026-08-11",
  "status": "candidate_preregistration_before_implementation",
  "implementation_authorized_by_this_file": false,
  "canonicalized": false,
  "mission": "Test whether completely fresh ChatGPT invocations using structured provider-grounded temporal transition experience outperform equivalent fresh invocations using materially equivalent conventional episodic memory.",
  "governing_constraints": {
    "no_extra_safety_or_approval_layer": true,
    "no_extra_guardrail_or_policy_engine": true,
    "no_architecture_theater": true,
    "no_separate_verifier_agent_or_pipeline": true,
    "no_generic_receipt_or_action_ledger": true,
    "persistent_transition_history_justification": "Only explicit world-learning episodes and epistemic records intrinsically required for prediction, outcome resolution, temporal belief reconstruction, and fresh-instance inheritance may persist."
  },
  "live_baselines": {
    "eye_commit": "53948b74701f51c29c9322dfa9f017ba6b45f4a4",
    "codeeye_commit": "1ca0f93d64bc20bccb3b96dbcda43a2232783609",
